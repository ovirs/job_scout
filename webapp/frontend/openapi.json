{
  "openapi": "3.1.0",
  "info": {
    "title": "Job Scout",
    "version": "0.1.0"
  },
  "paths": {
    "/api/job-postings": {
      "get": {
        "summary": "List Job Postings",
        "operationId": "list_job_postings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobPostingRead"
                  },
                  "type": "array",
                  "title": "Response List Job Postings"
                }
              }
            }
          }
        }
      }
    },
    "/api/job-postings/similar": {
      "get": {
        "summary": "Find Similar Job Postings",
        "description": "Stored postings from the same company, compared case- and whitespace-insensitively,\nthe most similar title first: the possible duplicates of a posting about to be saved.",
        "operationId": "find_similar_job_postings",
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Company"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Title"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobPostingRead"
                  },
                  "title": "Response Find Similar Job Postings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/job-postings/{job_posting_id}": {
      "get": {
        "summary": "Get Job Posting",
        "operationId": "get_job_posting",
        "parameters": [
          {
            "name": "job_posting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Posting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPostingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/job-postings/{job_posting_id}/close": {
      "post": {
        "summary": "Close Job Posting",
        "description": "Close a posting, keeping it: a Manual Entry is closed only by the user.",
        "operationId": "close_job_posting",
        "parameters": [
          {
            "name": "job_posting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Posting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPostingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/job-postings/{job_posting_id}/reopen": {
      "post": {
        "summary": "Reopen Job Posting",
        "operationId": "reopen_job_posting",
        "parameters": [
          {
            "name": "job_posting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Posting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPostingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clippings": {
      "post": {
        "summary": "Submit Clipping",
        "description": "Store the pasted text as a pending Clipping and queue its extraction; poll it for\nthe result.",
        "operationId": "submit_clipping",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClippingSubmit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClippingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clippings/{clipping_id}": {
      "get": {
        "summary": "Get Clipping",
        "operationId": "get_clipping",
        "parameters": [
          {
            "name": "clipping_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Clipping Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClippingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clippings/{clipping_id}/retry": {
      "post": {
        "summary": "Retry Clipping",
        "description": "Queue the extraction of a failed clipping again.",
        "operationId": "retry_clipping",
        "parameters": [
          {
            "name": "clipping_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Clipping Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClippingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clippings/{clipping_id}/confirm": {
      "post": {
        "summary": "Confirm Clipping",
        "description": "Save a done Clipping as a Manual Entry, with the user's corrections.",
        "operationId": "confirm_clipping",
        "parameters": [
          {
            "name": "clipping_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Clipping Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClippingConfirm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPostingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clippings/{clipping_id}/abandon": {
      "post": {
        "summary": "Abandon Clipping",
        "description": "Give up on a done or failed Clipping, for instance for a similar posting already\nstored; nothing is saved as a Job Posting.",
        "operationId": "abandon_clipping",
        "parameters": [
          {
            "name": "clipping_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Clipping Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClippingRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{kind}": {
      "get": {
        "summary": "Get Current Document",
        "description": "The current version of a document, or null while the user has not written it.",
        "operationId": "get_current_document",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "career-profile",
                "preferences",
                "writing-guide"
              ],
              "type": "string",
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DocumentVersionRead"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Current Document"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{kind}/versions": {
      "post": {
        "summary": "Save Document",
        "operationId": "save_document",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "career-profile",
                "preferences",
                "writing-guide"
              ],
              "type": "string",
              "title": "Kind"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentSave"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{kind}/versions/{version_id}": {
      "get": {
        "summary": "Get Document Version",
        "operationId": "get_document_version",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "career-profile",
                "preferences",
                "writing-guide"
              ],
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Version Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deal-breakers": {
      "get": {
        "summary": "Get Current Deal Breakers",
        "description": "The current set of Deal Breakers, or null while the user has added none.",
        "operationId": "get_current_deal_breakers",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DealBreakerSetVersionRead"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Current Deal Breakers"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add Deal Breaker",
        "description": "Add a Deal Breaker; returns the new version of the set.",
        "operationId": "add_deal_breaker",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealBreakerSave"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealBreakerSetVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deal-breakers/{deal_breaker_id}": {
      "put": {
        "summary": "Edit Deal Breaker",
        "description": "Change a Deal Breaker's text, keeping its id; returns the new version of the set.",
        "operationId": "edit_deal_breaker",
        "parameters": [
          {
            "name": "deal_breaker_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Deal Breaker Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealBreakerSave"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealBreakerSetVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Deal Breaker",
        "description": "Delete a Deal Breaker; returns the new version of the set, without it.",
        "operationId": "delete_deal_breaker",
        "parameters": [
          {
            "name": "deal_breaker_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Deal Breaker Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealBreakerSetVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deal-breakers/versions/{version_id}": {
      "get": {
        "summary": "Get Deal Breaker Set Version",
        "operationId": "get_deal_breaker_set_version",
        "parameters": [
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",

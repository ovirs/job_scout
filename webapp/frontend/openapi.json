        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealBreakerSetVersionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClippingConfirm": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "company": {
            "type": "string",
            "minLength": 1,
            "title": "Company"
          },
          "location_text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Text"
          },
          "workplace_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "remote",
                  "hybrid",
                  "onsite"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Workplace Type"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title",
          "company",
          "description"
        ],
        "title": "ClippingConfirm",
        "description": "The envelope of the Manual Entry, as the user corrected it on the confirmation screen."
      },
      "ClippingExtractionRead": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "location_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Text"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "description_cut": {
            "type": "boolean",
            "title": "Description Cut"
          },
          "extracted_fields": {
            "$ref": "#/components/schemas/ExtractedFields"
          }
        },
        "type": "object",
        "required": [
          "title",
          "company",
          "location_text",
          "description",
          "description_cut",
          "extracted_fields"
        ],
        "title": "ClippingExtractionRead"
      },
      "ClippingRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "failed",
              "confirmed",
              "abandoned"
            ],
            "title": "Status"
          },
          "pasted_text": {
            "type": "string",
            "title": "Pasted Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExtractionFailureRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "extraction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClippingExtractionRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "job_posting_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Posting Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "pasted_text",
          "url",
          "created_at",
          "model",
          "prompt_version",
          "failure",
          "extraction",
          "job_posting_id"
        ],
        "title": "ClippingRead"
      },
      "ClippingSubmit": {
        "properties": {
          "pasted_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Pasted Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "pasted_text"
        ],
        "title": "ClippingSubmit"
      },
      "DealBreakerRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "DealBreakerRead"
      },
      "DealBreakerSave": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "DealBreakerSave"
      },
      "DealBreakerSetVersionRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "deal_breakers": {
            "items": {
              "$ref": "#/components/schemas/DealBreakerRead"
            },
            "type": "array",
            "title": "Deal Breakers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "created_at",
          "deal_breakers"
        ],
        "title": "DealBreakerSetVersionRead"
